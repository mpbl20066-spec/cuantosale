{
  "name": "cuantosale",
  "version": "0.1.0",
  "private": true,
  "description": "CuántoSale: compará vuelos, buses y alojamiento desde Uruguay y mirá el costo total del viaje.",
  "scripts": {
    "build:costos": "node scripts/build-costos.js",
    "check:costos": "node scripts/validar-costos.js",
    "build:transfer": "node scripts/build-transfer.js",
    "check:transfer": "node scripts/validar-transfer.js",
    "build:tours": "node scripts/build-tours.js",
    "check:tours": "node scripts/validar-tours.js",
    "check:tema": "node scripts/validar-tema.js",
    "check:checkout": "node test-checkout.js",
    "check:hoteles": "node test-hoteles.js",
    "merge": "node scripts/merge-ramas.js",
    "push": "node scripts/merge-ramas.js --push",
    "build:todo": "npm run build:costos && npm run build:transfer && npm run build:tours",
    "check:todo": "npm run check:costos && npm run check:transfer && npm run check:tours && npm run check:tema && npm run check:checkout && npm run check:hoteles",
    "pull:aeropuertos": "node scripts/pull-aeropuertos.js",
    "pull:distancias": "node scripts/pull-distancias.js",
    "pull:rutas-mapa": "node scripts/pull-rutas-mapa.js",
    "build:paradas-auto": "node scripts/build-paradas-auto.js",
    "pull:transfer": "node scripts/build-transfer-precios.js",
    "build:sql-costos": "node scripts/build-transfer-costos-sql.js",
    "costos:sql": "python scripts/build-costos-desde-xlsx.py",
    "check:xlsx-costos": "python scripts/_prueba-xlsx-costos.py",
    "cargar:tours": "node scripts/cargar-tours.js",
    "cargar:transfer-precios": "python scripts/cargar-transfer-precios.py",
    "db:estado": "node scripts/db-tabla.js estado",
    "db:ver": "node scripts/db-tabla.js ver",
    "db:pull": "node scripts/db-tabla.js pull",
    "tabla": "node scripts/db-tabla.js pull",
    "prestart": "npm run build:todo",
    "start": "node server.js",
    "pretest": "npm run build:todo",
    "test": "node test.js",
    "test:guias": "node test-guias-humo.js",
    "test:tours": "node test-tours.js",
    "test:cache": "node test-serpapi-cache.js",
    "reels": "node outputs/reels/_build/capture.js && node outputs/reels/_build/vo.js && node outputs/reels/_build/build.js",
    "historias": "node outputs/historias/_build/build.js",
    "historias:limpio": "node outputs/historias/_build/build.js limpio"
  },
  "engines": {
    "node": ">=18"
  }
}
