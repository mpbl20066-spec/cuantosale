# Copiá este archivo como .env y completá tus datos. NUNCA subas .env a GitHub.

# ---------- Vuelos: Duffel ----------
# Token de tu cuenta Duffel. Prueba: duffel_test_...  Producción: duffel_live_...
# Sin token la app funciona en modo demo (precios estimados).
DUFFEL_TOKEN=
# Escalas máximas en las búsquedas (0, 1 o 2). Vacío = lo decide Duffel.
DUFFEL_MAX_CONNECTIONS=
# Solo si Duffel te devuelve precios en otras monedas: tipos de cambio a US$ en JSON. Ej: {"EUR":1.08}
DUFFEL_FX=
# Minutos que se recuerda un precio de vuelo antes de volver a consultarlo
QUOTE_TTL_MIN=60

# ---------- Reserva de vuelos: Duffel Links ----------
# URL pública de tu sitio, sin barra final (Duffel vuelve acá al terminar la reserva). Ej: https://cuantosale.uy
PUBLIC_BASE_URL=
# Clave para firmar las referencias de reserva. Poné un texto largo y al azar.
SESSION_SECRET=
# links = checkout de Duffel Links | affiliate = enlace de afiliados de FLIGHT_URL_TEMPLATE
FLIGHT_BOOKING_MODE=links
# Tu comisión sobre las tarifas (opcional). Ver "markup" en la guía de Duffel Links.
DUFFEL_MARKUP_AMOUNT=
DUFFEL_MARKUP_RATE=
# Enlace de respaldo si Links falla o si usás FLIGHT_BOOKING_MODE=affiliate.
# Marcadores: {origin} {destination} {dep} {ret} {pax} {affiliate}
FLIGHT_URL_TEMPLATE=
FLIGHT_AFFILIATE_ID=

# ---------- Hoteles: Booking.com (Demand API) ----------
# Token (Bearer) y número de afiliado de tu cuenta de la Demand API
BOOKING_API_KEY=
BOOKING_AFFILIATE_ID=
# Producción por defecto. Para pruebas: https://demandapi-sandbox.booking.com/3.1
BOOKING_API_BASE=
# IDs de ciudad para buscar por ciudad en vez de por aeropuerto (ver scripts/booking-cities.js). Ej: {"fln": 123456}
BOOKING_CITY_IDS=
# Solo si Booking devuelve precios en otra moneda: tipos de cambio a US$ en JSON. Ej: {"BRL":0.18}
BOOKING_FX=
# Enlace de respaldo de hoteles (si no se define, búsqueda en Booking.com con tu ID de afiliado)
HOTEL_URL_TEMPLATE=

# ---------- Ómnibus, ferry y seguro (enlaces de afiliados) ----------
BUS_URL_TEMPLATE=
BUS_AFFILIATE_ID=
FERRY_URL_TEMPLATE=
FERRY_AFFILIATE_ID=
INSURANCE_URL_TEMPLATE=
INSURANCE_AFFILIATE_ID=

# ---------- Servidor ----------
PORT=3000
# Búsquedas por minuto permitidas por persona (protege tus cuentas de abusos)
RATE_LIMIT_PER_MIN=30
