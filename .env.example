# Copiá este archivo como .env y completá tus datos. NUNCA subas .env a GitHub.

# SerpAPI, motor google_flights (precios reales de vuelos; solo servidor).
# Se eligió porque funciona desde Uruguay: las APIs que además venden boletos
# (Duffel, Amadeus, Sabre) piden aprobación y tienen restricciones por mercado.
# Sin esta key los vuelos muestran precios estimados y la app sigue funcionando.
# Dashboard: https://serpapi.com/ -> Copy API Key
SERPAPI_API_KEY=

# Vuelos falsos para probar la app sin gastar un solo crédito. Ponelo en 1 y
# olvidate de SerpAPI mientras estas probando: el calendario de fechas son 15
# búsquedas por apertura de propuesta, así que una tanda de pruebas puede vaciar
# el plan del mes.
#
# Los precios salen de un hash de (ruta, fechas, cabina), no del azar: la misma
# búsqueda da siempre el mismo número, que es lo que permite que un test afirme
# sobre el total. Las ofertas vienen con las dos patas (ida y vuelta), con
# airlines reales de la región, y con `provider: "mock"` para que un test las
# distinga de las de verdad.
#
# NO lo uses en produccion: los precios son inventados. Si se muestran sin
# aclarar que son falsos, el error es peor que no mostrar nada.
MOCK_FLIGHTS=0
# País e idioma con los que Google Flights responde. Sin esto los precios pueden
# venir en la moneda por defecto de SerpAPI y los nombres de aeropuerto en
# inglés, que no es lo que ve un usuario de Uruguay.
SERPAPI_GL=uy
SERPAPI_HL=es
# Cabina para el estilo "cómodo" (1 economy, 2 premium economy, 3 business).
SERPAPI_CABIN_COMODO=2
# Horas que se guarda el precio de un punto del calendario de fechas. El precio
# de un vuelo no cambia de un día a otro y el crédito es el recurso caro, así
# que un día entero es un default conservador. Bajarlo hace que cada visita
# pague las 15 búsquedas del gráfico de nuevo.
SERPAPI_CALENDAR_TTL_H=24
# Máximo de puntos guardados en memoria (cada uno es una búsqueda ya cobrada).
SERPAPI_CACHE_MAX=2000

# Puerto del servidor (los hostings suelen definirlo solos)
PORT=3000

# Candado del prelanzamiento: con las dos variables puestas, /app y /grupo
# piden usuario y contraseña (HTTP Basic) y el resto de la web sigue abierta.
# Sin ellas no hay candado, así el desarrollo local funciona sintrampear.
# El candado se aplica por archivo, no por ruta: /app, /app/ y /index.html
# quedan todos protegidos, igual que /grupo y /grupo.html.
APP_USER=
APP_PASS=

# Supabase (solo la clave anon/pública llega al navegador; nunca uses la service_role aquí)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# También se acepta SUPABASE_PUBLISHABLE_KEY o NEXT_PUBLIC_SUPABASE_ANON_KEY.

# Booking / RapidAPI (hoteles reales; credenciales independientes de vuelos)
BOOKING_API_KEY=
BOOKING_API_HOST=booking-com15.p.rapidapi.com
BOOKING_API_URL=https://booking-com15.p.rapidapi.com/api/v1/hotels/searchHotels
BOOKING_DESTINATION=Florianópolis

# Búsquedas por minuto permitidas por persona (protege tu cuenta de abusos)
RATE_LIMIT_PER_MIN=30

# Google Analytics 4. La etiqueta se inyecta sola en todas las páginas HTML desde
# server.js (no la pegues en los .html: quedaría duplicada). Si lo cambiás acá,
# cambiá también los dominios de Google en la CSP de server.js.
GA_MEASUREMENT_ID=G-JJSG6WSTYZ

# Travelpayouts (marker de tu cuenta de afiliado, llega al navegador vía /api/config)
TRAVELPAYOUTS_MARKER=

# Tasas de cambio del selector de moneda (exchangerate-api.com).
# Opcional: sin key se usa el endpoint v4, que es gratis.
EXCHANGERATE_API_KEY=

# Links de afiliado de Travelpayouts (lo que hace que una reserva de hotel
# genere comision). Opcional: sin token los botones de "Reservar" siguen
# apuntando a Booking.com, solo que sin comision para nosotros.
# El token se saca de travelpayouts.com -> Profile -> API token.
TRAVELPAYOUTS_API_TOKEN=
# "trs" es el id del PROYECTO suscrito a Booking.com. No es lo mismo que el
# marker: son dos numeros distintos y mandarlos cambiados devuelve 400.
TRAVELPAYOUTS_TRS=

# Civitatis (actividades y tours con precio real). OAuth 2.0 client_credentials.
# Sin esto los tours siguen saliendo de la lista local de public/app.js.
# Las dos claves van en connectivity.civitatis.com -> B2B Partner.
CIVITATIS_API_KEY=
CIVITATIS_API_SECRET=
# Mapa de nuestros destinos a los destinationId de Civitatis: "rio=1,fln=2".
# Son IDs de Civitatis, no los nuestros. Búzios (buz) queda excluido a proposito:
# sus tours siguen viniendo de la lista local.
CIVITATIS_DESTINATIONS=