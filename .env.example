# Copiá este archivo como .env y completá tus datos. NUNCA subas .env a GitHub.

# Token de tu cuenta Duffel (dashboard de Duffel > Developers > Access tokens).
# Un token de prueba empieza con duffel_test_ y uno real con duffel_live_.
# Si lo dejás vacío, la app funciona en modo demo (precios estimados).
# Variable actual usada por la SDK oficial @duffel/api.
DUFFEL_ACCESS_TOKEN=
# Seguridad: mantenelo en false/vacío hasta configurar el saldo y el flujo de pago.
DUFFEL_BOOKING_ENABLED=false
# Compatibilidad con la integración anterior; podés dejarla vacía.
DUFFEL_TOKEN=

# Puerto del servidor (los hostings suelen definirlo solos)
PORT=3000

# Supabase (solo la clave anon/pública llega al navegador; nunca uses la service_role aquí)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Minutos que se recuerda un precio de vuelo antes de volver a consultarlo (ahorra consultas)
QUOTE_TTL_MIN=60

# Escalas máximas en las búsquedas (0, 1 o 2). Vacío = lo decide Duffel.
DUFFEL_MAX_CONNECTIONS=

# Solo si Duffel te devuelve precios en otras monedas: tipos de cambio a US$ en JSON. Ejemplo:
# DUFFEL_FX={"EUR":1.08,"BRL":0.18}
DUFFEL_FX=

# Booking / RapidAPI (hoteles reales)
# Copiá este archivo como .env y completá tus claves reales.
BOOKING_API_KEY=
BOOKING_API_HOST=booking-com.p.rapidapi.com
BOOKING_API_URL=https://booking-com.p.rapidapi.com/v1/hotels/search
BOOKING_DESTINATION=Florianópolis

# Búsquedas por minuto permitidas por persona (protege tu cuenta de abusos)
RATE_LIMIT_PER_MIN=30
