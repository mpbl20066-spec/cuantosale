{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60,
        "includeFiles": "data/blog/**"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ],
  "crons": [
    {
      "path": "/api/precalentar",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/precalentar?ronda=2",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/precalentar?ronda=3",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/precalentar?ronda=4",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/precalentar?ronda=5",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/alertas/revisar",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/mails/revisar",
      "schedule": "0 12 * * *"
    }
  ]
}
